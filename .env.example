GITHUB_TOKEN=your_personal_access_token
GITHUB_OWNER=your_github_owner
PORT=3000

# Implement agent (Mistral Agents API)
MISTRAL_API_KEY=your_mistral_api_key
# Fine-grained PAT scoped to the WebDaw repo only:
# contents: read/write, pull requests: read/write, issues: read/write
GITHUB_PAT=your_scoped_github_pat

# Bot identity for the agent pipeline (branch/commit/PR writes, issue
# comments and labels). A fine-grained PAT for a dedicated bot account
# (e.g. yourname-bot) scoped to this repo only: contents RW, issues RW,
# pull requests RW, metadata R. The bot must be a repo collaborator.
# When set, all agent writes post as the bot so maintainers can approve
# the bot's PRs; the tokens above stay for app reads and user actions.
AGENT_GITHUB_TOKEN=your_bot_github_pat
# Optional overrides
# MISTRAL_AGENT_MODEL=devstral-2-latest
# MISTRAL_SCOPING_MODEL=devstral-2-latest
# MISTRAL_SCOPING_AGENT_NAME=scoping-agent
# MISTRAL_AGENT_NAME=implement-agent
# MISTRAL_CONNECTOR_NAME=github-mcp
# AGENT_PROMPT_PATH=./agent-prompt.md
# AGENT_RUN_BUDGET_MS=2700000
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# MISTRAL_CONNECTOR_VISIBILITY=private
# GITHUB_MCP_SERVER_URL=https://api.githubcopilot.com/mcp/
